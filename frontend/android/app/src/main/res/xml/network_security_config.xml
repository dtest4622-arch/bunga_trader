<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for localhost only (development) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">bunga-trader.onrender.com</domain>
        <domain includeSubdomains="true">xvpggkaavmekkencdkbh.supabase.co</domain>
        <!-- Trust the default system CAs -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    
    <!-- Allow localhost for development/testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
