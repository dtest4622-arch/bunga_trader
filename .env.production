# ============================================
# Bunga Trader - Production Environment
# ============================================
# Copy this to Railway Environment Variables
# ============================================

# App Settings
DEBUG=false
SECRET_KEY=generate-a-new-secret-key-for-production

# Server
HOST=0.0.0.0
PORT=8000

# Database - Use Railway PostgreSQL or Supabase
# Railway PostgreSQL (auto-provisioned):
DATABASE_URL=postgresql+asyncpg://postgres:[password]@localhost:5432/railway

# OR Supabase (your existing):
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.xvpggkaavmekkencdkbh.supabase.co:5432/postgres

# Redis - Railway Redis (auto-provisioned):
REDIS_URL=redis://localhost:6379

# External APIs
GROQ_API_KEY=your_groq_api_key

# Telegram API
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# M-Pesa Daraja API
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_ENV=sandbox

# MT5 Connection
MT5_HOST=localhost
MT5_PORT=5555

# Optional: Sentry
# SENTRY_DSN=your_sentry_dsn
